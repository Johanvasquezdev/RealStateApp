@model List<AgentChatSummaryViewModel>
@{ ViewData["Title"] = "Conversaciones"; }

<h2>Conversaciones</h2>
@if (Model.Any())
{
    <div class="list-group">
        @foreach (var chat in Model)
        {
            <a asp-action="Conversacion" asp-route-clientId="@chat.ClientId" class="list-group-item list-group-item-action d-flex align-items-center p-3">
                @if (!string.IsNullOrEmpty(chat.ClientPhoto) && chat.ClientPhoto != "default-user.png" && chat.ClientPhoto != "default-profile.png")
                {
                    <img src="@chat.ClientPhoto" alt="Profile" class="rounded-circle me-3 object-fit-cover shadow-sm" style="width: 50px; height: 50px;" onerror="this.onerror=null;this.src='/img/default-user.png';" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-white fs-4 fw-bold shadow-sm" style="width: 50px; height: 50px; background-color: #12402d;">
                        @(chat.ClientName.Substring(0, 1))
                    </div>
                }
                <div class="flex-grow-1" style="min-width: 0;">
                    <div class="d-flex w-100 justify-content-between align-items-center">
                        <h6 class="mb-1 fw-bold">@chat.ClientName</h6>
                        <small class="text-muted">@chat.LastMessageDate.ToString("dd/MM/yy HH:mm")</small>
                    </div>
                    <p class="mb-0 text-muted small text-truncate">@(chat.LastMessage ?? "Sin mensajes")</p>
                </div>
            </a>
        }
    </div>
}
else
{
    <p>No hay conversaciones para esta propiedad.</p>
}
<a asp-controller="PropertyMaintenance" asp-action="Detail" asp-route-id="@ViewBag.PropertyId" class="btn btn-secondary mt-3">Volver</a>
