@model List<AgentPropertyViewModel>
@{ ViewData["Title"] = "Panel del Agente"; }

<div class="container py-5">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="fw-bolder" style="color: #0a261c; font-size: 2.5rem; letter-spacing: -1px;">Bienvenido al Panel del Agente</h2>
            <p class="text-muted fs-5">Aquí tienes un resumen de tu actividad reciente.</p>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-5">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: linear-gradient(145deg, #12402d, #0d3021); color: white;">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title text-white-50 m-0">Total Propiedades</h5>
                        <div class="bg-white bg-opacity-25 rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                            <i class="bi bi-building fs-4"></i>
                        </div>
                    </div>
                    <p class="card-text fw-bold m-0" style="font-size: 3rem;">@Model.Count</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="background: white;">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title text-muted m-0">Disponibles</h5>
                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #e8f5e9; color: #198754;">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                    </div>
                    <p class="card-text fw-bold m-0" style="font-size: 3rem; color: #0a261c;">@Model.Count(p => p.Status == "Available")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Properties Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
            <h5 class="m-0 fw-bold" style="color: #0a261c;">Propiedades Recientes</h5>
            <a asp-controller="PropertyMaintenance" asp-action="Index" class="btn btn-sm px-3 py-2 fw-bold" style="background-color: #f5f5f0; color: #0d4d3a;">
                Ver todas <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f8f9fa;">
                    <tr>
                        <th class="text-muted fw-semibold py-3 px-4 border-0">Imagen</th>
                        <th class="text-muted fw-semibold py-3 px-4 border-0">Código</th>
                        <th class="text-muted fw-semibold py-3 px-4 border-0">Precio</th>
                        <th class="text-muted fw-semibold py-3 px-4 border-0">Tipo</th>
                        <th class="text-muted fw-semibold py-3 px-4 border-0">Venta</th>
                        <th class="text-muted fw-semibold py-3 px-4 border-0">Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.Any())
                    {
                        @foreach (var p in Model.Take(5))
                        {
                            <tr>
                                <td class="py-3 px-4">
                                    <img src="@(string.IsNullOrEmpty(p.MainImage) ? "/img/default-property.jpg" : p.MainImage)" alt="Propiedad" class="img-thumbnail rounded-3" style="width: 60px; height: 60px; object-fit: cover;">
                                </td>
                                <td class="py-3 px-4 fw-bold">@p.Code</td>
                                <td class="py-3 px-4 fw-bold text-success">RD$ @p.Price.ToString("N2")</td>
                                <td class="py-3 px-4">@p.PropertyType</td>
                                <td class="py-3 px-4">@p.SaleType</td>
                                <td class="py-3 px-4">
                                    <span class="badge rounded-pill px-3 py-2 @(p.Status == "Available" ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">
                                        @(p.Status == "Available" ? "Disponible" : "Vendida/Alquilada")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                No hay propiedades registradas aún.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

