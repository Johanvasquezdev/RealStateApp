@model RealEstateApp.Core.Application.ViewModels.AgentProperties.AgentPropertyViewModel
@using RealEstateApp.Core.Application.ViewModels.AgentChats
@using RealEstateApp.Core.Application.ViewModels.AgentOffers
@{
    ViewData["Title"] = "Detalle de Propiedad";
    var conversations = ViewBag.Conversations as IEnumerable<AgentChatSummaryViewModel> ?? new List<AgentChatSummaryViewModel>();
    var offers = ViewBag.Offers as IEnumerable<AgentOfferSummaryViewModel> ?? new List<AgentOfferSummaryViewModel>();
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder mb-1" style="color: #0a261c;">Propiedad @Model.Code</h2>
            <span class="badge @(Model.Status == "Available" ? "bg-success" : "bg-secondary") fs-6 px-3 py-2 rounded-pill">
                @(Model.Status == "Available" ? "Disponible" : "Vendida")
            </span>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-2"></i>Volver
        </a>
    </div>

    <!-- Nav Tabs -->
    <ul class="nav nav-pills mb-4 gap-2" id="propertyTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill px-4" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab" aria-controls="info" aria-selected="true" style="color: #0a261c; font-weight: 500;">
                <i class="bi bi-info-circle me-2"></i>Información
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="chat-tab" data-bs-toggle="tab" data-bs-target="#chat" type="button" role="tab" aria-controls="chat" aria-selected="false" style="color: #0a261c; font-weight: 500;">
                <i class="bi bi-chat-dots me-2"></i>Conversaciones
                @if (conversations.Any())
                {
                    <span class="badge rounded-pill bg-danger ms-2">@conversations.Count()</span>
                }
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill px-4" id="offers-tab" data-bs-toggle="tab" data-bs-target="#offers" type="button" role="tab" aria-controls="offers" aria-selected="false" style="color: #0a261c; font-weight: 500;">
                <i class="bi bi-tags me-2"></i>Ofertas
                @if (offers.Any())
                {
                    <span class="badge rounded-pill bg-danger ms-2">@offers.Count()</span>
                }
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="propertyTabContent">
        <!-- Tab: Información -->
        <div class="tab-pane fade show active" id="info" role="tabpanel" aria-labelledby="info-tab">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4" style="color: #0a261c;">Detalles Principales</h5>
                            
                            <div class="row g-4">
                                <div class="col-sm-6">
                                    <div class="p-3 rounded-3" style="background-color: #f8f9fa;">
                                        <div class="text-muted small fw-semibold text-uppercase mb-1">Precio</div>
                                        <div class="fs-4 fw-bold" style="color: #12402d;">RD$ @Model.Price.ToString("N2")</div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 rounded-3" style="background-color: #f8f9fa;">
                                        <div class="text-muted small fw-semibold text-uppercase mb-1">Tamaño</div>
                                        <div class="fs-5 fw-bold" style="color: #12402d;">@Model.LandSize m²</div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4 g-3">
                                <div class="col-sm-6 col-md-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #e8f5e9; color: #12402d;">
                                            <i class="bi bi-door-open fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="text-muted small">Habitaciones</div>
                                            <div class="fw-bold">@Model.Rooms</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #e8f5e9; color: #12402d;">
                                            <i class="bi bi-droplet fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="text-muted small">Baños</div>
                                            <div class="fw-bold">@Model.Bathrooms</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-md-6">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; background-color: #e8f5e9; color: #12402d;">
                                            <i class="bi bi-house-door fs-5"></i>
                                        </div>
                                        <div>
                                            <div class="text-muted small">Tipo</div>
                                            <div class="fw-bold">@Model.PropertyType (@Model.SaleType)</div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4 text-muted">
                            
                            <h6 class="fw-bold mb-3" style="color: #0a261c;">Descripción</h6>
                            <p class="text-muted">@Model.Description</p>
                            
                            @if (Model.Improvements.Any())
                            {
                                <h6 class="fw-bold mt-4 mb-3" style="color: #0a261c;">Mejoras</h6>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var mejora in Model.Improvements)
                                    {
                                        <span class="badge rounded-pill" style="background-color: #e8f5e9; color: #12402d; font-weight: 500; padding: 8px 16px;">
                                            <i class="bi bi-check-circle me-1"></i> @mejora
                                        </span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded-4 h-100">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4" style="color: #0a261c;">Galería</h5>
                            @if (Model.Images != null && Model.Images.Any())
                            {
                                <div class="row g-2">
                                    @foreach (var img in Model.Images)
                                    {
                                        <div class="col-6">
                                            <a href="@img" target="_blank">
                                                <img src="@img" class="img-fluid rounded-3 object-fit-cover w-100 h-100" style="min-height: 120px;" alt="Imagen">
                                            </a>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted p-4 bg-light rounded-3">
                                    <i class="bi bi-image fs-1 mb-2"></i>
                                    <p class="mb-0">Sin imágenes</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab: Conversaciones -->
        <div class="tab-pane fade" id="chat" role="tabpanel" aria-labelledby="chat-tab">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="p-4 border-bottom">
                        <h5 class="fw-bold mb-0" style="color: #0a261c;">Conversaciones Activas</h5>
                    </div>
                    
                    @if (conversations.Any())
                    {
                        <div class="list-group list-group-flush rounded-bottom-4">
                            @foreach (var conv in conversations)
                            {
                                <a asp-controller="Chat" asp-action="Conversacion" asp-route-propertyId="@Model.Id" asp-route-clientId="@conv.ClientId" class="list-group-item list-group-item-action p-4 border-0 border-bottom" style="transition: all 0.2s;">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(conv.ClientPhoto) && conv.ClientPhoto != "default-user.png" && conv.ClientPhoto != "default-profile.png")
                                            {
                                                <img src="@conv.ClientPhoto" alt="Profile" class="rounded-circle me-3 object-fit-cover shadow-sm" style="width: 50px; height: 50px;" onerror="this.onerror=null;this.src='/img/default-user.png';" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-white fs-4 shadow-sm" style="width: 50px; height: 50px; background-color: #12402d;">
                                                    @(conv.ClientName.Substring(0, 1))
                                                </div>
                                            }
                                            <div>
                                                <h6 class="mb-1 fw-bold">@conv.ClientName</h6>
                                                <p class="mb-0 text-muted small text-truncate" style="max-width: 300px;">
                                                    @if (!string.IsNullOrEmpty(conv.LastMessage))
                                                    {
                                                        @conv.LastMessage
                                                    }
                                                    else
                                                    {
                                                        <em>Sin mensajes</em>
                                                    }
                                                </p>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            @if (!string.IsNullOrEmpty(conv.LastMessage))
                                            {
                                                <small class="text-muted d-block mb-2">@conv.LastMessageDate.ToString("g")</small>
                                            }
                                            <span class="btn btn-sm rounded-pill px-3" style="background-color: #e8f5e9; color: #12402d;">
                                                Ver Chat <i class="bi bi-chevron-right ms-1"></i>
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <i class="bi bi-chat-square-text text-muted" style="font-size: 3rem;"></i>
                            <h5 class="mt-3 text-muted">No hay conversaciones</h5>
                            <p class="text-muted mb-0">Aún ningún cliente ha escrito por esta propiedad.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Tab: Ofertas -->
        <div class="tab-pane fade" id="offers" role="tabpanel" aria-labelledby="offers-tab">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0">
                    <div class="p-4 border-bottom">
                        <h5 class="fw-bold mb-0" style="color: #0a261c;">Ofertas Recibidas</h5>
                    </div>
                    
                    @if (offers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead style="background-color: #f8f9fa;">
                                    <tr>
                                        <th class="px-4 py-3 text-muted small fw-semibold text-uppercase border-0">Cliente</th>
                                        <th class="px-4 py-3 text-muted small fw-semibold text-uppercase border-0">Ofertas</th>
                                        <th class="px-4 py-3 text-muted small fw-semibold text-uppercase border-0">Última Oferta</th>
                                        <th class="px-4 py-3 text-muted small fw-semibold text-uppercase border-0">Estado</th>
                                        <th class="px-4 py-3 text-end text-muted small fw-semibold text-uppercase border-0">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var offer in offers)
                                    {
                                        <tr>
                                            <td class="px-4 py-3">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(offer.ClientPhoto) && offer.ClientPhoto != "default-user.png" && offer.ClientPhoto != "default-profile.png")
                                                    {
                                                        <img src="@offer.ClientPhoto" alt="Profile" class="rounded-circle me-3 object-fit-cover shadow-sm" style="width: 40px; height: 40px;" onerror="this.onerror=null;this.src='/img/default-user.png';" />
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3 text-white fs-6 fw-bold shadow-sm" style="width: 40px; height: 40px; background-color: #12402d;">
                                                            @(offer.ClientName.Substring(0, 1))
                                                        </div>
                                                    }
                                                    <div class="fw-bold" style="color: #0a261c;">@offer.ClientName</div>
                                                </div>
                                            </td>
                                            <td class="px-4 py-3">
                                                <span class="badge rounded-pill px-3 py-2" style="background-color: #e8f5e9; color: #12402d;">@offer.OfferCount</span>
                                            </td>
                                            <td class="px-4 py-3 fw-bold" style="color: #12402d;">RD$ @offer.LatestOfferAmount.ToString("N2")</td>
                                            <td class="px-4 py-3">
                                                @{
                                                    string badgeClass = offer.Status switch
                                                    {
                                                        "Pending" => "bg-warning text-dark",
                                                        "Accepted" => "bg-success text-white",
                                                        "Rejected" => "bg-danger text-white",
                                                        _ => "bg-secondary text-white"
                                                    };
                                                }
                                                <span class="badge rounded-pill @badgeClass px-3 py-2 fw-medium">@offer.Status</span>
                                            </td>
                                            <td class="px-4 py-3 text-end">
                                                <a asp-controller="Offer" asp-action="Detalle" asp-route-propertyId="@Model.Id" asp-route-clienteId="@offer.ClientId" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-medium">
                                                    <i class="bi bi-eye me-1"></i> Ver Ofertas
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-5">
                            <i class="bi bi-tag text-muted" style="font-size: 3rem;"></i>
                            <h5 class="mt-3 text-muted">No hay ofertas</h5>
                            <p class="text-muted mb-0">Aún no has recibido ofertas por esta propiedad.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-pills .nav-link.active {
        background-color: #12402d !important;
        color: white !important;
    }
    .nav-pills .nav-link:not(.active):hover {
        background-color: #e8f5e9;
    }
</style>
