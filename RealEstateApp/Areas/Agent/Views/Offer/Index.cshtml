@model List<AgentOfferSummaryViewModel>
@{ ViewData["Title"] = "Ofertas por Propiedad"; }

<h2>Ofertas</h2>
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Cantidad</th>
                <th>Última Oferta</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            @if (!string.IsNullOrEmpty(o.ClientPhoto) && o.ClientPhoto != "default-user.png" && o.ClientPhoto != "default-profile.png")
                            {
                                <img src="@o.ClientPhoto" alt="Profile" class="rounded-circle me-2 object-fit-cover shadow-sm" style="width: 32px; height: 32px;" onerror="this.onerror=null;this.src='/img/default-user.png';" />
                            }
                            else
                            {
                                <div class="rounded-circle d-flex align-items-center justify-content-center me-2 text-white fw-bold shadow-sm" style="width: 32px; height: 32px; background-color: #12402d; font-size: 0.85rem;">
                                    @(o.ClientName.Substring(0, 1))
                                </div>
                            }
                            <span>@o.ClientName</span>
                        </div>
                    </td>
                    <td>@o.OfferCount</td>
                    <td>RD$ @o.LatestOfferAmount.ToString("N2")</td>
                    <td>
                        <span class="badge @(o.Status == "Pending" ? "bg-warning" : o.Status == "Accepted" ? "bg-success" : "bg-danger")">@o.Status</span>
                    </td>
                    <td>
                        <a asp-action="Detalle" asp-route-propertyId="@ViewBag.PropertyId" asp-route-clientId="@o.ClientId" class="btn btn-sm btn-info">Ver Detalle</a>
                        <a asp-controller="Chat" asp-action="Conversacion" asp-route-propertyId="@ViewBag.PropertyId" asp-route-clientId="@o.ClientId" class="btn btn-sm btn-outline-primary">Chat</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p>No hay ofertas para esta propiedad.</p>
}
<a asp-controller="PropertyMaintenance" asp-action="Detail" asp-route-id="@ViewBag.PropertyId" class="btn btn-secondary">Volver</a>
