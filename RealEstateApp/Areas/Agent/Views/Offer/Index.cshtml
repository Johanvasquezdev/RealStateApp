@model List<AgentOfferSummaryViewModel>
@{ ViewData["Title"] = "Ofertas por Propiedad"; }

<h2>Ofertas</h2>
<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Cliente</th>
                <th>Cantidad</th>
                <th>Última Oferta</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.ClientName</td>
                    <td>@o.OfferCount</td>
                    <td>RD$ @o.LatestOfferAmount.ToString("N2")</td>
                    <td>
                        <span class="badge @(o.Status == "Pending" ? "bg-warning" : o.Status == "Accepted" ? "bg-success" : "bg-danger")">@o.Status</span>
                    </td>
                    <td>
                        <a asp-action="Detalle" asp-route-propertyId="@ViewBag.PropertyId" asp-route-clientId="@o.ClientId" class="btn btn-sm btn-info">Ver Detalle</a>
                        <a asp-controller="Chat" asp-action="Conversacion" asp-route-clientId="@o.ClientId" class="btn btn-sm btn-outline-primary">Chat</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <p>No hay ofertas para esta propiedad.</p>
}
<a asp-controller="PropiedadMantenimiento" asp-action="Index" class="btn btn-secondary">Volver</a>
