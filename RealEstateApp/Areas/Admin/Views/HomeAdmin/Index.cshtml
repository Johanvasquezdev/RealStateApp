@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Panel de Administración";
}

<div class="container py-4">
    <h2 class="mb-4 fw-bold">Panel de Administración</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-4">
        @foreach (var item in new[] {
            new { T = "Propiedades", V = Model.AvailableProperties.ToString(), I = "house" },
            new { T = "Vendidas", V = Model.SoldProperties.ToString(), I = "check2-circle" },
            new { T = "Agentes Act.", V = Model.ActiveAgents.ToString(), I = "person-badge" },
            new { T = "Agentes Inact.", V = Model.InactiveAgents.ToString(), I = "person-x" },
            new { T = "Clientes Act.", V = Model.ActiveClients.ToString(), I = "people" },
            new { T = "Clientes Inact.", V = Model.InactiveClients.ToString(), I = "person-slash" },
            new { T = "Devs Activos", V = Model.ActiveDevelopers.ToString(), I = "building" },
            new { T = "Devs Inactivos", V = Model.InactiveDevelopers.ToString(), I = "building-x" }
        })
        {
            <div class="col-6 col-md-3">
                <div class="card property-card border-0 shadow-sm p-3 text-center h-100">
                    <div class="navbar-brand-icon mx-auto mb-3" style="background-color: var(--primary); color: white;">
                        <i class="bi bi-@item.I"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-1" style="color: var(--primary);">@item.V</h4>
                        <p class="text-gray mb-0" style="font-size: 0.8rem; font-weight: 600;">@item.T</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>