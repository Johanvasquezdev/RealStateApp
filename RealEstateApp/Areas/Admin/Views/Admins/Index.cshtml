@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Mantenimiento de administradores";
}

<h2 class="mb-4">Mantenimiento de administradores</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">Crear administrador</a>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Usuario</th>
            <th>Cédula</th>
            <th>Correo</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var admin in Model)
        {
            <tr>
                <td>@admin.FirstName</td>
                <td>@admin.LastName</td>
                <td>@admin.UserName</td>
                <td>@admin.IdCard</td>
                <td>@admin.Email</td>
                <td>
                    @if (admin.IsActive)
                    {
                        <span class="badge text-bg-success">Activo</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Inactivo</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@admin.Id" class="btn btn-sm btn-primary">Editar</a>
                    <form asp-action="ToggleStatus" asp-route-id="@admin.Id" asp-route-activate="@(!admin.IsActive ? "true" : "false")" method="post" class="d-inline">
                        @if (admin.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-warning"
                                    onclick="return confirm('¿Está seguro que desea inactivar este Administrador?');">
                                Inactivar
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-success"
                                    onclick="return confirm('¿Está seguro que desea activar este Administrador?');">
                                Activar
                            </button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
