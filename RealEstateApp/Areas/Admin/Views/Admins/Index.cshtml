@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Mantenimiento de administradores";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Administradores</h2>
        <a asp-action="Create" class="btn btn-primary">Crear administrador</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card property-card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Usuario</th>
                        <th>Cédula</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var admin in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@admin.FirstName @admin.LastName</td>
                            <td>@admin.UserName</td>
                            <td>@admin.IdCard</td>
                            <td>
                                <span class="badge @(admin.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
                                    @(admin.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@admin.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="ToggleStatus" asp-route-id="@admin.Id" asp-route-activate="@(!admin.IsActive ? "true" : "false")" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(admin.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            onclick="confirmAction(event, '¿Confirmar acción?', '¿Está seguro que desea @(admin.IsActive ? "inactivar" : "activar") este Administrador?');">
                                        @(admin.IsActive ? "Inactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>