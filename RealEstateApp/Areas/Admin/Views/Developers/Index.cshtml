@model List<UserListItemViewModel>
@{
    ViewData["Title"] = "Mantenimiento de desarrolladores";
}

<div class="container-fluid px-4 px-xl-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Desarrolladores</h2>
        <a asp-action="Create" class="btn btn-primary">Crear desarrollador</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card property-card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Usuario</th>
                        <th>Cédula</th>
                        <th>Correo</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var dev in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@dev.FirstName @dev.LastName</td>
                            <td>@dev.UserName</td>
                            <td>@dev.IdCard</td>
                            <td>@dev.Email</td>
                            <td>
                                <span class="badge @(dev.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
                                    @(dev.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@dev.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Editar</a>
                                <form asp-action="ToggleStatus" asp-route-id="@dev.Id" asp-route-activate="@(!dev.IsActive ? "true" : "false")" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(dev.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3"
                                            onclick="confirmAction(event, '¿Confirmar acción?', '¿Está seguro que desea @(dev.IsActive ? "inactivar" : "activar") este Desarrollador?');">
                                        @(dev.IsActive ? "Inactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>