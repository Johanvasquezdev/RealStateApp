@model List<PropertyTypeViewModel>
@{
    ViewData["Title"] = "Mantenimiento de tipo de propiedades";
}

<div class="container-fluid px-4 px-xl-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Tipos de propiedades</h2>
        <a asp-action="Create" class="btn btn-primary">Crear tipo de propiedad</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card property-card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Nombre</th>
                        <th>Descripción</th>
                        <th>Propiedades asociadas</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.Name</td>
                            <td>@item.Description</td>
                            <td>@item.PropertiesCount</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 justify-content-end align-items-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">Editar</a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline m-0">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                                onclick="confirmAction(event, '¿Eliminar tipo de propiedad?', 'Esta acción no se puede deshacer.');">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>