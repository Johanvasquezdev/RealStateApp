@model UserListItemViewModel
@{
    ViewData["Title"] = "Eliminar agente";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card property-card border-0 shadow-sm p-4">
                <h2 class="h4 mb-4">Eliminar agente</h2>
                <div class="alert alert-warning mb-4">
                    <i class="bi bi-exclamation-triangle-fill"></i> ¿Está seguro que desea eliminar este agente y todas sus propiedades? Esta acción no se puede deshacer.
                </div>

                <div class="mb-4">
                    <p class="text-gray mb-1" style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Detalles del agente</p>
                    <p class="mb-1"><strong>Nombre:</strong> @Model.FirstName @Model.LastName</p>
                    <p class="mb-1"><strong>Correo:</strong> @Model.Email</p>
                    <p class="mb-0"><strong>Propiedades vinculadas:</strong> @Model.PropertiesCount</p>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" style="background-color: #dc3545 !important; border-color: #dc3545 !important;">Confirmar eliminación</button>
                        <a asp-action="Index" class="btn btn-outline-primary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>