@model List<ClientPropertyViewModel>
@{
    ViewData["Title"] = "Inicio";
    var filter = ViewBag.Filter as ClientFilterPropertyViewModel;
}

<div class="container-fluid px-0">
    <div class="position-relative overflow-hidden text-start shadow-lg mb-5 hero-section" style="background: linear-gradient(to right, rgba(15, 23, 42, 0.9) 0%, rgba(15, 23, 42, 0.4) 100%), url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80') center/cover; min-height: 600px; display: flex; align-items: center; border-radius: 0 0 3rem 3rem;">
        <div class="container p-5 fade-in-up position-relative z-1">
            <div style="max-width: 600px;">
                <p class="text-white-50 fw-bold mb-3" style="letter-spacing: 2px; font-size: 0.85rem;">UNA MEJOR FORMA DE VIVIR</p>
                <h1 class="display-3 fw-bolder text-white mb-4" style="letter-spacing: -1px; line-height: 1.1;">Tu próximo lugar se siente como hogar.</h1>
                <p class="lead text-white-50 mb-5 fw-light">Descubre las mejores propiedades con la tecnología más avanzada del mercado. Tu futuro comienza aquí.</p>
            </div>
        </div>
    </div>

    <div class="container position-relative" style="z-index: 10;">
        <div class="row justify-content-center">
            <div class="col-12" style="max-width: 1100px; margin-top: -35px; margin-bottom: 3rem;">
                <div class="search-bar-modern mx-3">
                    <form method="get" asp-controller="Home" asp-action="Index" class="d-flex flex-wrap align-items-center w-100 gap-2 p-2">
                        <div class="search-input-group flex-grow-1" style="min-width: 120px;">
                            <label>Código</label>
                            <input type="text" name="Code" placeholder="Ej. 123456" value="@filter?.Code">
                        </div>
                        
                        <div class="search-divider d-none d-md-block"></div>
                        
                        <div class="search-input-group flex-grow-1" style="min-width: 150px;">
                            <label>Tipo Propiedad</label>
                            <select name="PropertyTypeId" class="form-select border-0 shadow-none p-0" style="background-color: transparent;">
                                <option value="">Todos</option>
                                @if(ViewBag.PropertyTypes != null)
                                {
                                    foreach(var pt in ViewBag.PropertyTypes)
                                    {
                                        if (filter?.PropertyTypeId == pt.Id)
                                        {
                                            <option value="@pt.Id" selected>@pt.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@pt.Id">@pt.Name</option>
                                        }
                                    }
                                }
                            </select>
                        </div>

                        <div class="search-divider d-none d-md-block"></div>
                        
                        <div class="search-input-group flex-grow-1" style="min-width: 100px;">
                            <label>Precio Mín.</label>
                            <input type="number" name="MinPrice" placeholder="$0" value="@filter?.MinPrice">
                        </div>
                        
                        <div class="search-divider d-none d-md-block"></div>
                        
                        <div class="search-input-group flex-grow-1" style="min-width: 100px;">
                            <label>Precio Máx.</label>
                            <input type="number" name="MaxPrice" placeholder="Sin límite" value="@filter?.MaxPrice">
                        </div>

                        <div class="search-divider d-none d-md-block"></div>

                        <div class="search-input-group flex-grow-1" style="min-width: 90px;">
                            <label>Hab.</label>
                            <input type="number" name="Rooms" placeholder="Camas" value="@filter?.Rooms">
                        </div>

                        <div class="search-divider d-none d-md-block"></div>

                        <div class="search-input-group flex-grow-1" style="min-width: 90px;">
                            <label>Baños</label>
                            <input type="number" name="Bathrooms" placeholder="Baños" value="@filter?.Bathrooms">
                        </div>

                        <div class="ms-auto pe-2 ps-3 d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill py-2 px-3 fw-bold hover-lift d-flex align-items-center gap-2">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                            <a asp-action="Index" class="btn btn-light rounded-pill py-2 px-3 fw-bold hover-lift d-flex align-items-center gap-2 text-muted border">
                                Limpiar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-end mb-5 fade-in-up">
            <div>
                <p class="text-primary fw-bold mb-1" style="font-size: 0.85rem; letter-spacing: 1px;">SELECCIÓN CURADA</p>
                <h2 class="fw-bolder text-dark mb-0" style="font-size: 2.5rem; letter-spacing: -1px;">Propiedades disponibles</h2>
            </div>
            <a asp-controller="Agents" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                Conoce a nuestros agentes <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info rounded-4 border-0 shadow-sm text-center p-5">
                <h4 class="alert-heading fw-bold mb-3">No hay propiedades</h4>
                <p class="mb-0">No encontramos ninguna propiedad disponible en este momento con los filtros seleccionados.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var property in Model)
                {
                    <div class="col fade-in-up">
                        <div class="card property-card h-100 border-0 rounded-4 position-relative">
                            <div class="property-img-wrapper position-relative">
                                <img src="@(string.IsNullOrEmpty(property.MainImageUrl) ? "/img/default-property.jpg" : property.MainImageUrl)" 
                                     onerror="this.onerror=null; this.src='/img/default-property.jpg';"
                                     class="property-img" alt="@property.Code">
                                
                                <span class="tag-badge">
                                    <i class="bi bi-circle-fill me-1" style="font-size: 8px; color: @(property.SaleTypeName == "Venta" ? "var(--bs-primary)" : "var(--bs-info)");"></i>
                                    @property.SaleTypeName
                                </span>

                                <form method="post" asp-area="Client" asp-controller="ClientFavorite" asp-action="ToggleFavorite" asp-route-id="@property.Id" class="d-inline position-absolute top-0 end-0 m-3 favorite-form" style="z-index: 3; position: relative;">
                                    <button type="submit" class="btn btn-light rounded-circle shadow-sm p-2 d-flex align-items-center justify-content-center toggle-favorite-btn" style="width: 40px; height: 40px;" title="@(property.IsFavorite ? "Quitar de favoritos" : "Agregar a favoritos")">
                                        <i class="bi @(property.IsFavorite ? "bi-heart-fill" : "bi-heart") fs-5 text-danger"></i>
                                    </button>
                                </form>
                                
                                <div class="position-absolute bottom-0 start-0 w-100 p-3 bg-gradient-dark">
                                    <div class="text-white d-flex justify-content-between align-items-end">
                                        <div>
                                            <h5 class="fw-bolder mb-0">RD$ @property.Price.ToString("N2")</h5>
                                            <small class="opacity-75"><i class="bi bi-geo-alt me-1"></i>Código: @property.Code</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card-body p-4">
                                <div class="mb-3">
                                    <h5 class="card-title fw-bold text-truncate mb-0">@property.PropertyTypeName</h5>
                                </div>

                                <div class="row g-0 text-gray small fw-medium mt-3 border-top pt-3">
                                    <div class="col-4 d-flex align-items-center justify-content-center border-end">
                                        <i class="bi bi-door-open fs-5 me-2"></i> @property.Rooms Hab
                                    </div>
                                    <div class="col-4 d-flex align-items-center justify-content-center border-end">
                                        <i class="bi bi-droplet fs-5 me-2"></i> @property.Bathrooms Baños
                                    </div>
                                    <div class="col-4 d-flex align-items-center justify-content-center">
                                        <i class="bi bi-arrows-fullscreen fs-5 me-2"></i> @property.LandSize m²
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card-footer bg-white border-top-0 p-4 pt-0 d-flex justify-content-between align-items-center" style="z-index: 2; position: relative;">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(string.IsNullOrEmpty(property.AgentPhotoUrl) ? "/img/default-user.png" : property.AgentPhotoUrl)" 
                                         onerror="this.onerror=null; this.src='/img/default-user.png';"
                                         class="rounded-circle" style="width: 30px; height: 30px; object-fit: cover;" alt="@property.AgentName">
                                    <span class="fw-bold fs-7 text-dark">@property.AgentName</span>
                                </div>
                                <a asp-area="" asp-controller="Home" asp-action="Details" asp-route-id="@property.Id" class="btn btn-sm btn-outline-primary rounded-pill fw-bold stretched-link">Ver detalle</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .bg-gradient-dark {
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 100%);
    }
    .fs-7 {
        font-size: 0.85rem;
    }
</style>
