@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="mb-4 text-danger">
                <i class="bi bi-shield-lock-fill" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-5 fw-bold mb-3">Acceso Denegado</h1>
            <p class="lead text-muted mb-5">No tienes los permisos necesarios para acceder a esta sección.</p>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                if (User.IsInRole("Administrador"))
                {
                    <a asp-area="Admin" asp-controller="HomeAdmin" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4">
                        <i class="bi bi-house me-2"></i>Ir al Inicio (Admin)
                    </a>
                }
                else if (User.IsInRole("Agente"))
                {
                    <a asp-area="Agent" asp-controller="AgentHome" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4">
                        <i class="bi bi-house me-2"></i>Ir al Inicio (Agente)
                    </a>
                }
                else if (User.IsInRole("Cliente"))
                {
                    <a asp-area="Client" asp-controller="ClientProperty" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4">
                        <i class="bi bi-house me-2"></i>Ir al Inicio (Cliente)
                    </a>
                }
                else
                {
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4">
                        <i class="bi bi-house me-2"></i>Ir al Inicio
                    </a>
                }
            }
            else
            {
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4">
                    <i class="bi bi-house me-2"></i>Ir al Inicio
                </a>
            }
        </div>
    </div>
</div>
