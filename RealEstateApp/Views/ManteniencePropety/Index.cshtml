@model List<AgentPropertyViewModel>
@{ ViewData["Title"] = "Mis Propiedades"; }

<h2>Mis Propiedades</h2>
<a asp-action="Create" class="btn btn-success mb-3">Agregar Propiedad</a>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Precio</th>
                <th>Tipo</th>
                <th>Venta</th>
                <th>Habitaciones</th>
                <th>Baños</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Code</td>
                    <td>RD$ @p.Price.ToString("N2")</td>
                    <td>@p.PropertyType</td>
                    <td>@p.SaleType</td>
                    <td>@p.Rooms</td>
                    <td>@p.Bathrooms</td>
                    <td><span class="badge @(p.Status == "Disponible" ? "bg-success" : "bg-secondary")">@p.Status</span></td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@p.Id" class="btn btn-sm btn-info">Detalle</a>
                        <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
