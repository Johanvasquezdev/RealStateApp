@model List<AgentListViewModel>
@{ ViewData["Title"] = "Agentes Inmobiliarios"; }

<h2>Agentes Inmobiliarios</h2>

<form method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="nombreFilter" class="form-control" placeholder="Buscar por nombre..." value="@ViewBag.NombreFilter" />
        <button class="btn btn-primary" type="submit">Buscar</button>
    </div>
</form>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var agente in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="@(string.IsNullOrEmpty(agente.ProfilePictureUrl) ? "~/images/profiles/default-profile.png" : "~/images/profiles/" + agente.ProfilePictureUrl)" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@agente.FullName" asp-append-version="true" />
                <div class="card-body">
                    <h5 class="card-title">@agente.FullName</h5>
                    <p class="card-text">
                        <span class="badge bg-info">@agente.PropertyCount propiedades</span>
                    </p>
                    <a asp-action="Detalle" asp-route-id="@agente.Id" class="btn btn-outline-primary">Ver Detalle</a>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay agentes activos disponibles.</div>
}
