@model AgenteListViewModel
@{ ViewData["Title"] = "Detalle del Agente"; }

<div class="card mb-4">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@(string.IsNullOrEmpty(Model.ProfilePictureUrl) ? "~/images/profiles/default-profile.png" : "~/images/profiles/" + Model.ProfilePictureUrl)" class="img-fluid rounded-start" alt="@Model.NombreCompleto" asp-append-version="true" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h3 class="card-title">@Model.NombreCompleto</h3>
                <p class="card-text"><span class="badge bg-info">@Model.CantidadPropiedades propiedades disponibles</span></p>
            </div>
        </div>
    </div>
</div>

<h4>Propiedades</h4>
@{
    var propiedades = ViewBag.Propiedades as List<PropiedadViewModel>;
}
@if (propiedades is not null && propiedades.Any())
{
    <div class="row">
        @foreach (var prop in propiedades)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Código: @prop.Code</h5>
                        <p class="card-text">RD$ @prop.Price.ToString("N2")</p>
                        <p class="card-text">@prop.PropertyType</p>
                        <span class="badge @(prop.Status == "Disponible" ? "bg-success" : "bg-secondary")">@prop.Status</span>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>Este agente no tiene propiedades disponibles.</p>
}

<a asp-action="Index" class="btn btn-secondary">Volver</a>
