@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }

<div class="row g-0 bg-light" style="min-height: calc(100vh - 76px);">
    <!-- Left Column: Form -->
    <div class="col-lg-5 d-flex flex-column justify-content-center px-4 px-md-5 bg-white shadow-sm z-1">
        <div class="mx-auto w-100" style="max-width: 420px;">
            <!-- Brand / Logo space could go here -->
            <div class="mb-5 text-center text-lg-start">
                <h1 class="fw-bolder text-dark mb-2" style="font-size: 2.75rem; letter-spacing: -1px;">Bienvenido</h1>
                <p class="text-muted fs-6">Inicia sesión para gestionar tus propiedades y favoritos.</p>
            </div>

            @if (TempData["Mensaje"] is not null)
            {
                <div class="alert alert-success d-flex align-items-center border-0 rounded-3 shadow-sm mb-4" role="alert">
                    <i class="bi bi-check-circle-fill fs-5 me-3 text-success"></i>
                    <div>@TempData["Mensaje"]</div>
                </div>
            }

            @if (TempData["Error"] is not null)
            {
                <div class="alert alert-danger d-flex align-items-center border-0 rounded-3 shadow-sm mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-3 text-danger"></i>
                    <div>@TempData["Error"]</div>
                </div>
            }

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>
                
                <div class="form-floating mb-3">
                    <input asp-for="UsuarioOCorreo" class="form-control bg-light border-0" id="floatingInput" placeholder="Correo electrónico" />
                    <label for="floatingInput" class="text-muted">Usuario o Correo</label>
                    <span asp-validation-for="UsuarioOCorreo" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <div class="form-floating mb-4">
                    <input asp-for="Password" class="form-control bg-light border-0" type="password" id="floatingPassword" placeholder="Contraseña" />
                    <label for="floatingPassword" class="text-muted">Contraseña</label>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <button type="submit" class="btn btn-success w-100 py-3 mb-4 rounded-3 fw-bold shadow-sm text-white" style="font-size: 1.1rem; transition: all 0.2s;">
                    Iniciar sesión
                </button>
            </form>
            
            <div class="text-center text-lg-start mt-2">
                <p class="text-muted mb-2">
                    ¿No tienes cuenta? 
                    <a asp-controller="Account" asp-action="Register" class="text-dark fw-bold text-decoration-none border-bottom border-dark border-2 pb-1">Regístrate</a>
                </p>
                <p class="text-muted mb-0">
                    ¿Falta activar? 
                    <a asp-action="ResendActivation" class="text-dark fw-bold text-decoration-none border-bottom border-dark border-2 pb-1">Reenviar correo</a>
                </p>
            </div>
        </div>
    </div>

    <!-- Right Column: Image -->
    <div class="col-lg-7 d-none d-lg-block position-relative p-0 m-0">
        <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" 
             alt="Arquitectura Moderna" 
             class="w-100 h-100" 
             style="object-fit: cover;" />
        <!-- Overlay -->
        <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(to right, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 100%); pointer-events: none;"></div>
        <div class="position-absolute bottom-0 start-0 p-5 w-100">
            <div class="ms-4 mb-4">
                <span class="badge bg-white text-dark px-3 py-2 rounded-pill fw-bold mb-3 shadow-sm">Premium Real Estate</span>
                <h2 class="text-white fw-bolder mb-2" style="font-size: 3rem; text-shadow: 0 2px 10px rgba(0,0,0,0.3);">Encuentra el hogar<br>de tus sueños.</h2>
                <p class="text-white-50 fs-5 mb-0" style="text-shadow: 0 1px 5px rgba(0,0,0,0.5);">Las mejores propiedades en un solo lugar.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        box-shadow: 0 0 0 4px rgba(33, 37, 41, 0.1);
        border-color: #212529 !important;
        background-color: #fff !important;
    }
    .btn-primary:hover {
        background-color: #0d2e20 !important;
        border-color: #0d2e20 !important;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.2) !important;
    }
    /* Hide layout padding for full screen */
    main { padding: 0 !important; }
    .container { max-width: 100%; padding: 0; }
</style>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}