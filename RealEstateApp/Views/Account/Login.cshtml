@model LoginViewModel
@{ ViewData["Title"] = "Iniciar sesión"; }

<div class="row g-0 shadow-lg rounded-4 overflow-hidden" style="min-height: 75vh;">
    <div class="col-lg-5 d-flex flex-column justify-content-center p-5 bg-white">
        <div class="mx-auto" style="width: 100%; max-width: 400px;">

            <h1 class="fw-bolder mb-2" style="font-size: 2.5rem; letter-spacing: -1px;">Iniciar sesión</h1>
            <p class="text-gray mb-4 fs-6">Accede a tus favoritos, mensajes y ofertas.</p>

            @if (TempData["Mensaje"] is not null)
            {
                <div class="alert alert-info rounded-3 border-0 shadow-sm d-flex align-items-center mb-4">
                    <i class="bi bi-info-circle-fill fs-5 me-3 text-info"></i>
                    <div>@TempData["Mensaje"]</div>
                </div>
            }

            @if (TempData["Error"] is not null)
            {
                <div class="alert alert-danger rounded-3 border-0 shadow-sm d-flex align-items-center mb-4">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-3 text-danger"></i>
                    <div>@TempData["Error"]</div>
                </div>
            }

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small fw-bold"></div>
                
                <div class="mb-3">
                    <input asp-for="UsuarioOCorreo" class="form-control" placeholder="Correo electrónico" />
                    <span asp-validation-for="UsuarioOCorreo" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <div class="mb-4">
                    <input asp-for="Password" class="form-control" type="password" placeholder="Contraseña" />
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <button type="submit" class="btn btn-primary w-100 py-3 mb-4">
                    Iniciar sesión
                </button>
            </form>
            
            <div class="text-center">
                <p class="text-gray fw-medium mb-1" style="font-size: 0.9rem;">
                    ¿No tienes cuenta? 
                    <a asp-action="Registro" class="text-primary-custom fw-bold text-decoration-none">Únete aquí</a>
                </p>
                <p class="text-gray fw-medium mb-0" style="font-size: 0.9rem;">
                    ¿No te llegó el correo de activación? 
                    <a asp-action="ReenviarActivacion" class="text-primary-custom fw-bold text-decoration-none">Reenviar</a>
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-7 d-none d-lg-block p-4">
        <div class="h-100 w-100 rounded-4 overflow-hidden position-relative">
            <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" 
                 alt="Modern House" 
                 class="position-absolute w-100 h-100" 
                 style="object-fit: cover;" />
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}