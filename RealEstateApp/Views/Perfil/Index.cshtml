@model AgentProfileViewModel
@{ ViewData["Title"] = "Mi Perfil"; }

<h2>Mi Perfil</h2>

@if (TempData["Exito"] is not null)
{
    <div class="alert alert-success">@TempData["Exito"]</div>
}

<div class="row">
    <div class="col-md-4 mb-3 text-center">
        <img src="@(string.IsNullOrEmpty(Model.ExistingProfilePictureUrl) ? "~/images/profiles/default-profile.png" : "~/images/profiles/" + Model.ExistingProfilePictureUrl)" class="img-fluid rounded-circle" style="max-width: 200px;" alt="Foto de perfil" asp-append-version="true" />
    </div>
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ProfilePicture" class="form-label">Nueva foto de perfil</label>
                <input asp-for="ProfilePicture" class="form-control" type="file" accept="image/*" />
            </div>
            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
