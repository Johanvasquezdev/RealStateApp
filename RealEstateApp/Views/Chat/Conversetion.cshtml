@model AgentChatDetailViewModel
@{ ViewData["Title"] = $"Chat con {Model.ClienteNombre}"; }

<h2>Chat con @Model.ClienteNombre</h2>
<p><strong>Propiedad:</strong> @Model.PropertyCode</p>

<div class="card mb-3" style="max-height: 500px; overflow-y: auto;">
    <div class="card-body">
        @foreach (var m in Model.Mensajes)
        {
            <div class="d-flex @(m.SenderNombre == "Tú" ? "justify-content-end" : "justify-content-start") mb-3">
                <div class="p-3 rounded-3 @(m.SenderNombre == "Tú" ? "bg-primary text-white" : "bg-light")" style="max-width: 70%;">
                    <small class="d-block text-muted">@m.SenderNombre</small>
                    @m.Content
                    <small class="d-block text-muted text-end">@m.Created.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            </div>
        }
    </div>
</div>

<form method="post" asp-action="EnviarMensaje">
    <input type="hidden" name="ReceiverId" value="@Model.ClienteId" />
    <input type="hidden" name="PropertyId" value="@Model.PropertyId" />
    <div class="input-group">
        <textarea name="Content" class="form-control" rows="2" required placeholder="Escriba su mensaje..."></textarea>
        <button class="btn btn-primary" type="submit">Enviar</button>
    </div>
</form>

<a asp-action="Index" asp-route-propertyId="@Model.PropertyId" class="btn btn-secondary mt-2">Volver</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
