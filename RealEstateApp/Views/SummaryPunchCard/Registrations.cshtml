@model List<RegistrationPunchCardDto>
@{
    ViewData["Title"] = "Registros Punch Card";
    var filtro = (FilterPunchCardDto)ViewBag.Filtro;
    var sesiones = (IEnumerable<SessionPunchCardDto>)ViewBag.Sesiones;
    var totalRegistros = (int)ViewBag.TotalRegistros;
    var totalPaginas = (int)ViewBag.TotalPaginas;
}

<h2 class="text-gold">Registros Punch Card</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="post" class="row g-3 mb-4">
    @Html.AntiForgeryToken()
    <div class="col-md-3">
        <label class="form-label">Sesion</label>
        <select name="SesionId" class="form-select">
            <option value="">Todas</option>
            @foreach (var s in sesiones)
            {
                <option value="@s.Id" selected="@(filtro.SesionId == s.Id)">@s.NombreArchivo (@s.FechaSubida.ToString("dd/MM/yyyy"))</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Nombre</label>
        <input type="text" name="NombreEmpleado" value="@filtro.NombreEmpleado" class="form-control" placeholder="Buscar..." />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <div class="form-check">
            <input type="checkbox" name="SoloLicencias" value="true" class="form-check-input" @(filtro.SoloLicencias ? "checked" : "") />
            <label class="form-check-label">Solo Licencias</label>
        </div>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <input type="hidden" name="Pagina" value="1" />
        <input type="hidden" name="TamanoPagina" value="@filtro.TamanoPagina" />
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        @if (filtro.SesionId.HasValue)
        {
            <div class="btn-group">
                <a asp-action="ExportarExcel" asp-route-sesionId="@filtro.SesionId" class="btn btn-success btn-sm">Excel</a>
                <a asp-action="ExportarPdf" asp-route-sesionId="@filtro.SesionId" class="btn btn-danger btn-sm">PDF</a>
                <a asp-action="ExportarWord" asp-route-sesionId="@filtro.SesionId" class="btn badge-gold btn-sm">Word</a>
            </div>
        }
    </div>
</form>

<p>Total registros: <strong>@totalRegistros</strong></p>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron registros.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Departamento</th>
                    <th>Fecha</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Horas</th>
                    <th>Estado</th>
                    <th>Observacion</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="@((r.Estado == EstadoPunchCard.Licencia) ? "table-warning" : (r.Estado == EstadoPunchCard.Ausente) ? "table-danger" : "")">
                        <td>
                            @r.NombreEmpleado
                            @if (r.NombreEditado)
                            {
                                <span class="badge badge-gold" title="Nombre editado manualmente">*</span>
                            }
                        </td>
                        <td>@(r.Departamento ?? "-")</td>
                        <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@(r.HoraEntrada ?? "-")</td>
                        <td>@(r.HoraSalida ?? "-")</td>
                        <td>@(r.HorasTrabajadas?.ToString("N2") ?? "-")</td>
                        <td>
                            @if (r.Estado == EstadoPunchCard.Normal)
                            {
                                <span class="badge bg-success">Normal</span>
                            }
                            else if (r.Estado == EstadoPunchCard.Licencia)
                            {
                                <span class="badge bg-warning text-dark">Licencia</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ausente</span>
                            }
                        </td>
                        <td>@(r.Observacion ?? "-")</td>
                        <td>
                            <a asp-action="Editar" asp-route-id="@r.Id" class="btn btn-sm btn-warning">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPaginas > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int p = 1; p <= totalPaginas; p++)
                {
                    <li class="page-item @(p == filtro.Pagina ? "active" : "")">
                        <form method="post" class="page-link" style="border:none;background:none;padding:0;">
                            <input type="hidden" name="SesionId" value="@filtro.SesionId" />
                            <input type="hidden" name="NombreEmpleado" value="@filtro.NombreEmpleado" />
                            <input type="hidden" name="SoloLicencias" value="@filtro.SoloLicencias" />
                            <input type="hidden" name="Pagina" value="@p" />
                            <input type="hidden" name="TamanoPagina" value="@filtro.TamanoPagina" />
                            <button type="submit" class="page-link" style="border:none;background:none;color:inherit;">@p</button>
                        </form>
                    </li>
                }
            </ul>
        </nav>
    }
}
