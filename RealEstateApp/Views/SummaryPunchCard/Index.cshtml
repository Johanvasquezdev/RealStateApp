@model IEnumerable<SessionPunchCardDto>
@{ ViewData["Title"] = "Resumen de Punch Card"; }

<h2 class="text-gold">Resumen de Punch Card</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="mb-3">
    <a asp-action="Upload" class="btn btn-primary">Subir Archivo</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No hay sesiones registradas.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Archivo</th>
                    <th>Total Registros</th>
                    <th>Procesados</th>
                    <th>Errores</th>
                    <th>Subido por</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.NombreArchivo</td>
                        <td>@s.TotalRegistros</td>
                        <td>@s.RegistrosProcesados</td>
                        <td>@s.RegistrosConError</td>
                        <td>@(s.UsuarioNombre ?? "Sistema")</td>
                        <td>@s.FechaSubida.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <a asp-action="Registros" asp-route-sesionId="@s.Id" class="btn btn-sm btn-primary">Ver Registros</a>
                            <a asp-action="ExportarExcel" asp-route-sesionId="@s.Id" class="btn btn-sm btn-success">Excel</a>
                            <a asp-action="ExportarPdf" asp-route-sesionId="@s.Id" class="btn btn-sm btn-danger">PDF</a>
                            <a asp-action="ExportarWord" asp-route-sesionId="@s.Id" class="btn btn-sm badge-gold">Word</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
