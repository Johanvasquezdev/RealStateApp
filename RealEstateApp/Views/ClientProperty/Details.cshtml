@model RealEstateApp.Core.Application.ViewModels.Properties.ClientPropertyDetailViewModel
@{
    ViewData["Title"] = "Detalle de Propiedad";
}

<div class="container mt-4 mb-5">
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><strong>Error:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 border-0 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i><strong>Éxito:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bolder mb-1">
                @Model.PropertyTypeName
                <form method="post" asp-controller="ClientFavorite" asp-action="ToggleFavorite" asp-route-id="@Model.Id" class="d-inline ms-3 favorite-form">
                    <button type="submit" class="btn btn-light text-danger rounded-pill shadow-sm px-3 py-2 fw-bold" title="Agregar a favoritos">
                        <i class="bi bi-heart-fill me-1"></i> Guardar
                    </button>
                </form>
            </h1>
            <p class="text-muted fs-5 mb-0"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Tipo de Venta: @Model.SaleTypeName | Código: @Model.Code</p>
        </div>
        <div class="text-end">
            <p class="text-muted mb-0 fw-bold text-uppercase tracking-wide">Precio</p>
            <h2 class="text-primary fw-bolder mb-0">$@Model.Price.ToString("N2")</h2>
        </div>
    </div>

    <div class="row g-4">
        <!-- Galería y Descripción -->
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm overflow-hidden mb-4">
                @if (Model.ImageUrls != null && Model.ImageUrls.Any())
                {
                    <div id="propertyCarousel" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            @for (int i = 0; i < Model.ImageUrls.Count; i++)
                            {
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <img src="/images/properties/@Model.ImageUrls[i]" class="d-block w-100" alt="Imagen @i" style="height: 500px; object-fit: cover;">
                                </div>
                            }
                        </div>
                        @if (Model.ImageUrls.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon shadow" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon shadow" aria-hidden="true"></span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <img src="/img/default-property.jpg" class="img-fluid w-100" style="height: 500px; object-fit: cover;" alt="Sin imagen">
                }
            </div>

            <div class="card border-0 rounded-4 shadow-sm mb-4">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-4">Descripción</h4>
                    <p class="fs-5 text-muted lh-lg">@Model.Description</p>
                </div>
            </div>

            <div class="card border-0 rounded-4 shadow-sm mb-4">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-4">Mejoras de la Propiedad</h4>
                    <div class="row row-cols-2 row-cols-md-3 g-3">
                        @if (Model.Improvements != null && Model.Improvements.Any())
                        {
                            foreach (var imp in Model.Improvements)
                            {
                                <div class="col">
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-check2-circle text-success fs-4 me-2"></i>
                                        <span class="fs-6 fw-medium">@imp</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No tiene mejoras adicionales.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar: Info y Agente -->
        <div class="col-lg-4">
            <!-- Detalles Rápidos -->
            <div class="card border-0 rounded-4 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">Características</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                            <span class="text-muted"><i class="bi bi-door-open me-2"></i>Habitaciones</span>
                            <span class="fw-bold fs-5">@Model.Rooms</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                            <span class="text-muted"><i class="bi bi-droplet me-2"></i>Baños</span>
                            <span class="fw-bold fs-5">@Model.Bathrooms</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent">
                            <span class="text-muted"><i class="bi bi-arrows-fullscreen me-2"></i>Tamaño</span>
                            <span class="fw-bold fs-5">@Model.LandSize mt²</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Perfil del Agente -->
            <div class="card border-0 rounded-4 shadow-sm mb-4 bg-primary text-white">
                <div class="card-body p-4 text-center">
                    <h5 class="fw-bold mb-4 text-white-50 text-uppercase tracking-wide">Agente a Cargo</h5>
                    <img src="@(string.IsNullOrEmpty(Model.AgentPhotoUrl) ? "/img/default-user.png" : Model.AgentPhotoUrl)" alt="@Model.AgentName" class="rounded-circle mb-3 border border-3 border-white shadow" style="width: 120px; height: 120px; object-fit: cover;">
                    <h4 class="fw-bold mb-1">@Model.AgentName</h4>
                    <p class="text-white-50 mb-3"><i class="bi bi-envelope me-1"></i>@Model.AgentEmail</p>
                    
                    <div class="d-grid gap-2">
                        <a asp-controller="ClientAgent" asp-action="Details" asp-route-id="@Model.AgentId" class="btn btn-light rounded-pill fw-bold text-primary">
                            Ver Perfil del Agente
                        </a>
                        <a asp-controller="ClientChat" asp-action="Conversation" asp-route-propertyId="@Model.Id" asp-route-agentId="@Model.AgentId" class="btn btn-outline-light rounded-pill fw-bold mt-2">
                            <i class="bi bi-chat-dots-fill me-2"></i> Chatear con el Agente
                        </a>
                    </div>
                </div>
            </div>

            <!-- Acción de Oferta -->
            @if (Model.CanMakeOffer)
            {
                <div class="card border-0 rounded-4 shadow-sm bg-light">
                    <div class="card-body p-4 text-center">
                        <h5 class="fw-bold mb-3">¿Te interesa?</h5>
                        <p class="text-muted small mb-4">Haz una oferta formal por esta propiedad. El agente la revisará y te contactará.</p>
                        <button type="button" class="btn btn-success rounded-pill w-100 fw-bold py-3 shadow-sm btn-lg" data-bs-toggle="modal" data-bs-target="#offerModal">
                            <i class="bi bi-cash-coin me-2"></i>Hacer Oferta
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-0 rounded-4 shadow-sm bg-light border-warning border-start border-5">
                    <div class="card-body p-4">
                        <div class="d-flex">
                            <i class="bi bi-info-circle-fill text-warning fs-3 me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1">No puedes ofertar</h6>
                                <p class="text-muted small mb-0">Ya tienes una oferta pendiente o esta propiedad ya fue vendida (oferta aceptada).</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal para Oferta -->
@if (Model.CanMakeOffer)
{
    <div class="modal fade" id="offerModal" tabindex="-1" aria-labelledby="offerModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
          <div class="modal-header border-0 pb-0">
            <h5 class="modal-title fw-bold" id="offerModalLabel">Enviar Oferta</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form asp-controller="ClientOffer" asp-action="MakeOffer" method="post">
              <div class="modal-body">
                <input type="hidden" name="PropertyId" value="@Model.Id" />
                <p class="text-muted mb-4">Ingresa el monto que deseas ofrecer por <strong>@Model.PropertyTypeName</strong>.</p>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Monto de la Oferta (DOP)</label>
                    <div class="input-group input-group-lg">
                      <span class="input-group-text bg-light border-end-0"><i class="bi bi-currency-dollar"></i></span>
                      <input type="number" step="0.01" name="Amount" class="form-control border-start-0 bg-light" required min="1" placeholder="Ej. @Model.Price" />
                    </div>
                </div>
              </div>
              <div class="modal-footer border-0 pt-0 pb-4 px-4">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-bold" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">Confirmar Oferta</button>
              </div>
          </form>
        </div>
      </div>
    </div>
}
