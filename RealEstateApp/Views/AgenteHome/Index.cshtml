@model List<AgentPropertyViewModel>
@{ ViewData["Title"] = "Panel del Agente"; }

<h2>Panel del Agente</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title">Total Propiedades</h5>
                <p class="card-text display-6">@Model.Count</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title">Disponibles</h5>
                <p class="card-text display-6">@Model.Count(p => p.Status == "Disponible")</p>
            </div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Precio</th>
                <th>Tipo</th>
                <th>Venta</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.Code</td>
                    <td>RD$ @p.Price.ToString("N2")</td>
                    <td>@p.PropertyType</td>
                    <td>@p.SaleType</td>
                    <td><span class="badge @(p.Status == "Disponible" ? "bg-success" : "bg-secondary")">@p.Status</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-3">
    <a asp-controller="PropiedadMantenimiento" asp-action="Index" class="btn btn-primary">Gestionar Propiedades</a>
    <a asp-controller="Perfil" asp-action="Index" class="btn btn-outline-primary">Mi Perfil</a>
</div>
