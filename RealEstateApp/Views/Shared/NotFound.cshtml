@model string
@{
    ViewData["Title"] = "No Encontrado";
}

<div class="container text-center mt-5">
    <h1 class="display-4 text-danger">404</h1>
    <h3 class="mb-4">¡Oops!</h3>
    <p class="lead">
        @if (!string.IsNullOrEmpty(Model))
        {
            @Model
        }
        else
        {
            <text>El recurso solicitado no existe o no se encuentra disponible.</text>
        }
    </p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">Volver al Inicio</a>
</div>
