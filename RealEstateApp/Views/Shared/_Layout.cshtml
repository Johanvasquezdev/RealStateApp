<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealEstateApp.styles.css" asp-append-version="true" />
    <style>
        .reveal-hidden {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.6s ease-out;
        }
        .animate-reveal {
            opacity: 1 !important;
            transform: translateY(0) !important;
        }
    </style>
</head>
<body>
    <header class="bg-white border-bottom sticky-top py-2">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid px-4 px-lg-5">
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center gap-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="navbar-brand-icon">
                        <i class="bi bi-house-door-fill"></i>
                    </div>
                    <div class="d-flex flex-column lh-1">
                        <span class="fw-bolder text-dark fs-5">RealStateApp</span>
                        <span class="text-gray" style="font-size: 0.75rem; font-weight: 500;">Encuentra tu hogar</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <!-- Nav Pills (Center) -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 nav-pills bg-light rounded-pill p-1">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Cliente"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ClientProperty" ? "active" : "")" asp-controller="ClientProperty" asp-action="Index">
                                        <i class="bi bi-house"></i> Home
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Details" ? "active" : "")" href="#">
                                        <i class="bi bi-building"></i> Detalle
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ClientFavorite" ? "active" : "")" asp-controller="ClientProperty" asp-action="Index">
                                        <i class="bi bi-heart"></i> Favoritos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ClientChat" ? "active" : "")" asp-controller="ClientChat" asp-action="Index">
                                        <i class="bi bi-chat"></i> Chat
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ClientOffer" ? "active" : "")" asp-controller="ClientOffer" asp-action="Index">
                                        <i class="bi bi-tags"></i> Ofertas
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "ClientAgent" ? "active" : "")" asp-controller="ClientAgent" asp-action="Index">
                                        <i class="bi bi-people"></i> Agentes
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house"></i> Home
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3" asp-controller="Agentes" asp-action="Index">
                                        <i class="bi bi-people"></i> Agentes
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Agentes" ? "active" : "")" asp-controller="Agentes" asp-action="Index">
                                    <i class="bi bi-people"></i> Agentes
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- User Actions (Right) -->
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="bg-light rounded-pill px-3 py-2 d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle text-gray"></i>
                                <span class="fw-bold text-dark fs-7">@User.Identity.Name</span>
                            </div>
                            <a class="btn btn-primary" asp-controller="Cuenta" asp-action="Logout">Cerrar sesión</a>
                        }
                        else
                        {
                            <div class="bg-light rounded-pill px-3 py-2 d-flex align-items-center gap-2">
                                <i class="bi bi-globe text-gray"></i>
                                <span class="fw-bold text-dark fs-7">Nature</span>
                            </div>
                            <a class="btn btn-primary" asp-controller="Cuenta" asp-action="Login">Iniciar sesión</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - RealEstateApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/animations.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
